+-- SPIKE: the generic approximant-sequence relations (stand-in for
+-- `Data.Rational.Approximants` with an exact primitive).  Sequences are explicit:
+-- both relations unfold to a Π, so a sequence is never inferable from its type.
+module Seq where
+  infix 4 _≼_ _≼[_]_
+
+  _≼_ : (ℕ → ℚ) → (ℕ → ℚ) → Set
+  x ≼ y = (n : ℕ) → Σ[ m ∈ ℕ ] (x n ℚ.≤ y m)
+
+  _≼[_]_ : (ℕ → ℚ) → ℚ → (ℕ → ℚ) → Set
+  x ≼[ δ ] y = x ≼ (λ m → y m ℚ.+ δ)
+
+  ≼-refl : (x : ℕ → ℚ) → x ≼ x
+  ≼-refl x n = n , ≤-refl
+
+  ≼-trans : (x y z : ℕ → ℚ) → x ≼ y → y ≼ z → x ≼ z
+  ≼-trans x y z xy yz n = let m , le = xy n ; i , le′ = yz m in i , ≤-trans le le′
+
+  ≼-mapʳ : (x y y′ : ℕ → ℚ) → (∀ m → y m ℚ.≤ y′ m) → x ≼ y → x ≼ y′
+  ≼-mapʳ x y y′ f xy n = let m , le = xy n in m , ≤-trans le (f m)
+
+  ≼-+ʳ : (y y′ : ℕ → ℚ) (δ : ℚ) → y ≼ y′ → (λ m → y m ℚ.+ δ) ≼ (λ m → y′ m ℚ.+ δ)
+  ≼-+ʳ y y′ δ yy n = let m , le = yy n in m , +-monoˡ-≤ δ le
+
+  ≼⇒≼[0] : (x y : ℕ → ℚ) → x ≼ y → x ≼[ 0ℚ ] y
+  ≼⇒≼[0] x y = ≼-mapʳ x y _ λ m → ≤-reflexive (sym (+-identityʳ (y m)))
+
+  ≼[]-mono : (x y : ℕ → ℚ) → ε ℚ.≤ δ → x ≼[ ε ] y → x ≼[ δ ] y
+  ≼[]-mono x y le = ≼-mapʳ x _ _ λ m → +-monoʳ-≤ (y m) le
+
+  ≼[]-trans : (x y z : ℕ → ℚ) → x ≼[ ε ] y → y ≼[ δ ] z → x ≼[ ε ℚ.+ δ ] z
+  ≼[]-trans {ε = ε} {δ = δ} x y z p q =
+    ≼-mapʳ x _ _ (λ i → ≤-reflexive (trans (+-assoc (z i) δ ε) (cong (z i ℚ.+_) (+-comm δ ε))))
+           (≼-trans x _ _ p (≼-+ʳ y _ ε q))
+
+  ≼[]-resp : (x x′ y y′ : ℕ → ℚ) → x′ ≼ x → y ≼ y′ → x ≼[ ε ] y → x′ ≼[ ε ] y′
+  ≼[]-resp {ε = ε} x x′ y y′ l r p = ≼-trans x′ x _ l (≼-trans x _ _ p (≼-+ʳ y y′ ε r))
+
+cumₛ : {A : Set a} → Dₚ A → (A → ℚ) → ℕ → ℚ
+cumₛ d P n = cum n d P
+
